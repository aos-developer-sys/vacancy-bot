# Telegram API credentials — get from https://my.telegram.org
API_ID=
API_HASH=
PHONE=+1234567890

# Target channel/chat where matched vacancies get posted (invite link or @username)
TARGET_CHANNEL=

# Optional: separate target for HH.ru matches (defaults to TARGET_CHANNEL)
# HH_TARGET_CHANNEL=

# Optional: HH.ru search query override (see config.py for the default)
# HH_SEARCH_TEXT="project manager" OR "руководитель проекта"

# Optional: HH.ru region (113 = Russia, 1 = Moscow, 2 = St. Petersburg)
# HH_AREA=113

# Optional: HH.ru poll interval in seconds
# HH_POLL_INTERVAL=1800
