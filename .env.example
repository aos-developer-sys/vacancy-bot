# Telegram API credentials — get from https://my.telegram.org
API_ID=
API_HASH=
PHONE=+1234567890

# Target channel/chat where matched vacancies get posted (invite link or @username)
TARGET_CHANNEL=

# Optional: separate target for HH.ru matches (defaults to TARGET_CHANNEL)
# HH_TARGET_CHANNEL=

# Optional: HH.ru search query override (see config.py for the default)
# HH_SEARCH_TEXT="project manager" OR "руководитель проекта"

# Optional: HH.ru region (113 = Russia, 1 = Moscow, 2 = St. Petersburg)
# HH_AREA=113

# Optional: HH.ru poll interval in seconds
# HH_POLL_INTERVAL=1800

# HH.ru OAuth app credentials (client_credentials flow) — create an app at
# https://dev.hh.ru/admin and copy Client Id / Client Secret from there. Required.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Optional: pause between full-description requests, seconds
# HH_REQUEST_DELAY=0.3

# Optional: comma-separated professional_role ids to narrow the search server-side
# (see https://api.hh.ru/professional_roles). 107 = "Руководитель проектов".
# HH_PROFESSIONAL_ROLES=107

# Optional: comma-separated experience ids (noExperience, between1And3,
# between3And6, moreThan6)
# HH_EXPERIENCE=

# Optional: lookback window in hours for the very first poll, before any cutoff
# is stored in hh_seen.sqlite3
# HH_INITIAL_LOOKBACK_HOURS=24
